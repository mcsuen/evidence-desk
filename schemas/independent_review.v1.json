{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "ReviewFinding": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "severity": {
          "enum": [
            "error",
            "limitation",
            "note"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Evidence",
          "type": "array"
        },
        "correction": {
          "title": "Correction",
          "type": "string"
        }
      },
      "required": [
        "target",
        "severity",
        "message",
        "evidence",
        "correction"
      ],
      "title": "ReviewFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "enum": [
        "pass",
        "revise",
        "blocked"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ReviewFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "checked_assertions": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Checked Assertions",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Evidence",
      "type": "array"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "verdict",
    "findings",
    "checked_assertions",
    "evidence",
    "summary"
  ],
  "title": "IndependentReview",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pitr/independent_review.v1.json"
}

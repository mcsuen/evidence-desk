{
  "$defs": {
    "NewsSettings": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "cadence_minutes": {
          "default": 30,
          "maximum": 1440,
          "minimum": 5,
          "title": "Cadence Minutes",
          "type": "integer"
        },
        "daily_limit": {
          "default": 1000,
          "maximum": 10000,
          "minimum": 1,
          "title": "Daily Limit",
          "type": "integer"
        },
        "companies": {
          "items": {
            "type": "string"
          },
          "title": "Companies",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/NewsSource"
          },
          "maxItems": 100,
          "title": "Sources",
          "type": "array"
        }
      },
      "title": "NewsSettings",
      "type": "object"
    },
    "NewsSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "default": "rss",
          "enum": [
            "rss",
            "disclosure",
            "gdelt"
          ],
          "title": "Kind",
          "type": "string"
        },
        "url": {
          "default": "",
          "title": "Url",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "adapter": {
          "default": "",
          "title": "Adapter",
          "type": "string"
        },
        "company": {
          "default": "",
          "title": "Company",
          "type": "string"
        },
        "terms": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "NewsSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    },
    "settings": {
      "$ref": "#/$defs/NewsSettings"
    }
  },
  "required": [
    "operation_id",
    "settings"
  ],
  "title": "NewsSettingsInput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pitr/lab_news_settings_input.v1.json"
}

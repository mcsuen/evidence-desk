          "type": "string"
        },
        "snapshot": {
          "title": "Snapshot",
          "type": "string"
        },
        "anchor_period": {
          "title": "Anchor Period",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "$ref": "#/$defs/Assumption"
          },

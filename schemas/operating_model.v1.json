          "type": "string"
        },
        "investigation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Investigation Id"
        }
      },
      "required": [
        "snapshot",
        "anchor_period"
      ],
      "title": "ModelSpec",
      "type": "object"

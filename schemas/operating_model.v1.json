{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "parameter": {
          "title": "Parameter",
          "type": "string"
        },
        "period": {
          "title": "Period",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "provenance": {
          "default": "user",
          "enum": [
            "user",
            "mechanical_reference"
          ],

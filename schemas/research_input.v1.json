{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "subjects": {
          "items": {
            "type": "string"
          },
          "title": "Subjects",
          "type": "array"
        },
        "period": {
          "default": "",
          "title": "Period",
          "type": "string"
        },
        "mode": {
          "default": "live",
          "enum": [
            "live",
            "historical"
          ],
          "title": "Mode",
          "type": "string"
        },
        "as_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        },
        "allow_public_search": {
          "default": true,
          "title": "Allow Public Search",
          "type": "boolean"
        },
        "proof_level": {
          "default": "proven",
          "enum": [
            "proven",
            "declared"
          ],
          "title": "Proof Level",
          "type": "string"
        }
      },
      "required": [
        "subjects",
        "period",
        "mode",
        "as_of",
        "allow_public_search",
        "proof_level"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "question": {
      "maxLength": 16000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "maxItems": 40,
      "title": "Sources",
      "type": "array"
    },
    "knowledge": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Knowledge",
      "type": "array"
    },
    "depth": {
      "default": "standard",
      "enum": [
        "interactive",
        "standard",
        "deep"
      ],
      "title": "Depth",
      "type": "string"
    },
    "report_type": {
      "default": "memo",
      "enum": [
        "memo",
        "earnings",
        "company",
        "industry"
      ],
      "title": "Report Type",
      "type": "string"
    },
    "agent_provider": {
      "anyOf": [
        {
          "enum": [
            "codex",
            "claude"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Provider"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "reasoning": {
      "default": "medium",
      "title": "Reasoning",
      "type": "string"
    },
    "context": {
      "additionalProperties": true,
      "title": "Context",
      "type": "object"
    }
  },
  "required": [
    "id",
    "revision",
    "created_at",
    "question",
    "scope",
    "sources",
    "knowledge",
    "depth",
    "report_type",
    "agent_provider",
    "model",
    "reasoning",
    "context"
  ],
  "title": "ResearchInput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pitr/research_input.v1.json"
}

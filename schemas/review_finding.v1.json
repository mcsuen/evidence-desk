{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "severity": {
      "enum": [
        "error",
        "limitation",
        "note"
      ],
      "title": "Severity",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Evidence",
      "type": "array"
    },
    "correction": {
      "title": "Correction",
      "type": "string"
    }
  },
  "required": [
    "target",
    "severity",
    "message",
    "evidence",
    "correction"
  ],
  "title": "ReviewFinding",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pitr/review_finding.v1.json"
}

{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "subjects": {
          "items": {
            "type": "string"
          },
          "title": "Subjects",
          "type": "array"
        },
        "period": {
          "default": "",
          "title": "Period",
          "type": "string"
        },
        "mode": {
          "default": "live",
          "enum": [
            "live",
            "historical"
          ],
          "title": "Mode",
          "type": "string"
        },
        "as_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        },
        "allow_public_search": {
          "default": true,
          "title": "Allow Public Search",
          "type": "boolean"
        },
        "proof_level": {
          "default": "proven",
          "enum": [
            "proven",
            "declared"
          ],
          "title": "Proof Level",
          "type": "string"
        }
      },
      "required": [
        "subjects",
        "period",
        "mode",
        "as_of",
        "allow_public_search",
        "proof_level"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Sources",
      "type": "array"
    },
    "knowledge": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Knowledge",
      "type": "array"
    },
    "reused": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Reused",
      "type": "array"
    },
    "subject_versions": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Subject Versions",
      "type": "array"
    }
  },
  "required": [
    "id",
    "revision",
    "created_at",
    "scope",
    "sources",
    "knowledge",
    "reused",
    "subject_versions"
  ],
  "title": "Snapshot",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pitr/snapshot.v1.json"
}

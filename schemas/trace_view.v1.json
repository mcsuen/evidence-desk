{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "TraceLink": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "kind": {
          "enum": [
            "sequence",
            "dependency",
            "repair",
            "recovery",
            "artifact"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "kind"
      ],
      "title": "TraceLink",
      "type": "object"
    },
    "TraceSpan": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "executor": {
          "default": "controller",
          "title": "Executor",
          "type": "string"
        },
        "status": {
          "default": "running",
          "title": "Status",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "ended_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "timing": {
          "default": "missing",
          "enum": [
            "measured",
            "observed",
            "missing"
          ],
          "title": "Timing",
          "type": "string"
        },
        "attempt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt"
        },
        "generation": {
          "default": 0,
          "title": "Generation",
          "type": "integer"
        },
        "ordinal": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ordinal"
        },
        "input_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Version"
        },
        "artifact_refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "tool_count": {
          "default": 0,
          "title": "Tool Count",
          "type": "integer"
        },
        "issue_count": {
          "default": 0,
          "title": "Issue Count",
          "type": "integer"
        },
        "first_seq": {
          "default": 0,
          "title": "First Seq",
          "type": "integer"
        },
        "last_seq": {
          "default": 0,
          "title": "Last Seq",
          "type": "integer"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "parent_id",
        "name",
        "kind",
        "executor",
        "status",
        "started_at",
        "ended_at",
        "duration_ms",
        "timing",
        "attempt",
        "generation",
        "ordinal",
        "input_version",
        "artifact_refs",
        "tool_count",
        "issue_count",
        "first_seq",
        "last_seq",
        "metadata"
      ],
      "title": "TraceSpan",
      "type": "object"
    },
    "TraceSummary": {
      "additionalProperties": false,
      "properties": {
        "active_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Seconds"
        },
        "queue_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queue Seconds"
        },
        "waiting_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waiting Seconds"
        },
        "tool_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Seconds"
        },
        "measured_tools": {
          "default": 0,
          "title": "Measured Tools",
          "type": "integer"
        },
        "tool_count": {
          "default": 0,
          "title": "Tool Count",
          "type": "integer"
        },
        "budget_tool_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Tool Count"
        },
        "tokens": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Tokens",
          "type": "object"
        },
        "gaps": {
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        }
      },
      "required": [
        "active_seconds",
        "queue_seconds",
        "waiting_seconds",
        "tool_seconds",
        "measured_tools",
        "tool_count",
        "budget_tool_count",
        "tokens",
        "gaps"
      ],
      "title": "TraceSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "default": "trace.1",
      "title": "Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "seq": {
      "title": "Seq",
      "type": "integer"
    },
    "latest_seq": {
      "title": "Latest Seq",
      "type": "integer"
    },
    "task_status": {
      "title": "Task Status",
      "type": "string"
    },
    "spans": {
      "items": {
        "$ref": "#/$defs/TraceSpan"
      },
      "title": "Spans",
      "type": "array"
    },
    "links": {
      "items": {
        "$ref": "#/$defs/TraceLink"
      },
      "title": "Links",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/TraceSummary"
    }
  },
  "required": [
    "version",
    "run_id",
    "case_id",
    "seq",
    "latest_seq",
    "task_status",
    "spans",
    "links",
    "summary"
  ],
  "title": "TraceView",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pitr/trace_view.v1.json"
}

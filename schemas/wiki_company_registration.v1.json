{
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Operation Id",
      "type": "string"
    },
    "company": {
      "pattern": "^[A-Z][A-Z0-9.\\-]{0,15}$",
      "title": "Company",
      "type": "string"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "aliases": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Aliases",
      "type": "array"
    },
    "official_domains": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Official Domains",
      "type": "array"
    },
    "catalog_urls": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Catalog Urls",
      "type": "array"
    },
    "securities": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "maxItems": 12,
      "title": "Securities",
      "type": "array"
    },
    "brands": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Brands",
      "type": "array"
    },
    "identity_sources": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Identity Sources",
      "type": "array"
    }
  },
  "required": [
    "operation_id",
    "company",
    "name"
  ],
  "title": "CompanyRegistration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pitr/wiki_company_registration.v1.json"
}

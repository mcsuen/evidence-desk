{
  "$defs": {
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "rules",
        "semantic"
      ],
      "title": "Kind",
      "type": "string"
    },
    "company": {
      "title": "Company",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/Reference"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "scope": {
      "items": {
        "type": "string"
      },
      "title": "Scope",
      "type": "array"
    },
    "skipped": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Skipped",
      "type": "array"
    },
    "failures": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Failures",
      "type": "array"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    },
    "budget_seconds": {
      "default": 600,
      "title": "Budget Seconds",
      "type": "integer"
    },
    "budget_exhausted": {
      "default": false,
      "title": "Budget Exhausted",
      "type": "boolean"
    },
    "model_outputs": {
      "items": {
        "type": "string"
      },
      "title": "Model Outputs",
      "type": "array"
    },
    "elapsed_seconds": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elapsed Seconds"
    },
    "feedback": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Feedback"
    }
  },
  "required": [
    "id",
    "kind",
    "company",
    "policy",
    "started_at"
  ],
  "title": "InspectionRun",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pitr/wiki_inspection_run.v1.json"
}

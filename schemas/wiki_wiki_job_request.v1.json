{
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Operation Id",
      "type": "string"
    },
    "agent_provider": {
      "anyOf": [
        {
          "enum": [
            "codex",
            "claude"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Provider"
    },
    "model": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "intent": {
      "default": "build",
      "enum": [
        "build",
        "update"
      ],
      "title": "Intent",
      "type": "string"
    },
    "company": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Company",
      "type": "string"
    },
    "research_focus": {
      "default": "业务模式、盈利驱动、竞争、风险与现金转化",
      "maxLength": 12000,
      "title": "Research Focus",
      "type": "string"
    },
    "source_policy": {
      "const": "official_industry_media",
      "default": "official_industry_media",
      "title": "Source Policy",
      "type": "string"
    },
    "as_of": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "As Of"
    },
    "years": {
      "default": 3,
      "maximum": 10,
      "minimum": 1,
      "title": "Years",
      "type": "integer"
    },
    "quarters": {
      "default": 8,
      "maximum": 40,
      "minimum": 1,
      "title": "Quarters",
      "type": "integer"
    },
    "budget_seconds": {
      "default": 1200,
      "maximum": 1800,
      "minimum": 10,
      "title": "Budget Seconds",
      "type": "integer"
    },
    "max_documents": {
      "default": 24,
      "maximum": 40,
      "minimum": 1,
      "title": "Max Documents",
      "type": "integer"
    },
    "channel": {
      "default": "web",
      "enum": [
        "web",
        "slack",
        "cli",
        "schedule"
      ],
      "title": "Channel",
      "type": "string"
    },
    "seed_urls": {
      "items": {
        "type": "string"
      },
      "maxItems": 40,
      "title": "Seed Urls",
      "type": "array"
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 40,
      "title": "Source Ids",
      "type": "array"
    },
    "resume_job_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resume Job Id"
    }
  },
  "required": [
    "operation_id",
    "company"
  ],
  "title": "WikiJobRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pitr/wiki_wiki_job_request.v1.json"
}
